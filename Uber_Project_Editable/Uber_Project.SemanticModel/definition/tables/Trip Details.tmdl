	column 'Trip(Day / Night)' =
			
			VAR HourofDay = HOUR('Trip Details'[Pickup Time])
			RETURN
			IF(
			    HourofDay>=17 || HourofDay < 6,
			    "Night Trip" , "Day Trip"
			)
		lineageTag: 32106b86-d555-4c30-aa3c-6a6f86cd4703
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

