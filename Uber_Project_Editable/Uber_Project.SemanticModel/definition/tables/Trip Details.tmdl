table 'Trip Details'
	lineageTag: da718a21-5d41-41f6-bf38-16c92fc07042

	/// Distinct number of booked trips in the current filter context.
	measure 'Total Bookings' = DISTINCTCOUNT('Trip Details'[Trip ID])
		formatString: #,0.0
		displayFolder: Measures
		lineageTag: 670a0bd7-ea2c-4e2f-a512-915b86c456c7

	/// Total booking revenue, defined as fare amount plus surge fee.
	measure 'Total Booking Value' = SUM('Trip Details'[fare_amount]) + SUM('Trip Details'[Surge Fee])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: Measures
		lineageTag: 508675f9-3870-4ea6-8afa-f32b221ebf3d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Average booking revenue per distinct trip.
	measure 'Average Booking Value' = DIVIDE([Total Booking Value], [Total Bookings],BLANK())
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		displayFolder: Measures
		lineageTag: df501a08-a8c9-463b-a3d7-af84192a6fa6

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	/// Total trip distance in miles in the current filter context.
	measure 'Total Trip Distance' = SUM('Trip Details'[trip_distance])
		formatString: #,0.0
		displayFolder: Measures
		lineageTag: cd9c4925-5a7a-4a18-82cf-2b5bd9c19c9e

	/// Average trip distance in miles per distinct trip.
	measure 'Average Trip Distance' = AVERAGE('Trip Details'[trip_distance])
		formatString: 0.00 "miles"
		displayFolder: Measures
		lineageTag: 5ed82a53-d2d1-456c-903a-eed00abad66b

	/// Average elapsed trip duration in minutes.
	measure 'Average Trip Time' =
			AVERAGEX(
			    'Trip Details',
			    DIVIDE(
			        DATEDIFF(
			            'Trip Details'[Pickup Time],
			            'Trip Details'[Drop Off Time],
			            SECOND
			        ),
			        60.0
			    )
			)
		formatString: 0.00"min"
		displayFolder: Measures
		lineageTag: 7e6e5879-afc1-491c-83f7-a90e6a82ffca

	measure 'Tilte For Grid' = ```
			"Vehicle Type Analysis" 
			```
		displayFolder: Measures
		lineageTag: d1555ed0-1fe7-46e8-a1a0-ec1d32bc4bb0

	measure Measure
		displayFolder: Measures
		lineageTag: d35bea03-3a75-4bbd-b422-ecbb3ad61be2

	measure 'Most Frequent Dropoff Point' =
			
			VAR DropoffCounts =
			    FILTER(
			            ADDCOLUMNS(
			                        VALUES('Dropoff Locations'[Location]),
			                                    "Dropoff Count", CALCULATE([Total Bookings])
			                                            ),
			                                                    NOT ISBLANK('Dropoff Locations'[Location])
			                                                                && [Dropoff Count] > 0
			                                                                    )
			                                                                    VAR TopDropoffCount =
			                                                                        MAXX(DropoffCounts, [Dropoff Count])
			                                                                        VAR TopDropoffLocations =
			                                                                            FILTER(
			                                                                                    DropoffCounts,
			                                                                                            [Dropoff Count] = TopDropoffCount
			                                                                                                )
			                                                                                                RETURN
			                                                                                                    CONCATENATEX(
			                                                                                                            TopDropoffLocations,
			                                                                                                                    'Dropoff Locations'[Location],
			                                                                                                                            ", ",
			                                                                                                                                    'Dropoff Locations'[Location], ASC
			                                                                                                                                        )
		displayFolder: Measures
		lineageTag: e55affe2-69e9-47d9-9866-2f3fc37a7344

	measure 'Most Frequent Pickup Point' =
			
			VAR PickupCounts =
			    FILTER(
			            ADDCOLUMNS(
			                        VALUES('Pickup Locations'[Location]),
			                                    "Pickup Count", CALCULATE([Total Bookings])
			                                            ),
			                                                    NOT ISBLANK('Pickup Locations'[Location])
			                                                                && [Pickup Count] > 0
			                                                                    )
			                                                                    VAR TopPickupCount =
			                                                                        MAXX(PickupCounts, [Pickup Count])
			                                                                        VAR TopPickupLocations =
			                                                                            FILTER(
			                                                                                    PickupCounts,
			                                                                                            [Pickup Count] = TopPickupCount
			                                                                                                )
			                                                                                                RETURN
			                                                                                                    CONCATENATEX(
			                                                                                                            TopPickupLocations,
			                                                                                                                    'Pickup Locations'[Location],
			                                                                                                                            ", ",
			                                                                                                                                    'Pickup Locations'[Location], ASC
			                                                                                                                                        )
		displayFolder: Measures
		lineageTag: d72ca72e-7390-4c6c-ad68-8cc20f89c4ef

	measure 'Farthest Trip' =
			VAR FarthestTrip =
			    TOPN(
			        1,
			        FILTER(
			            'Trip Details',
			            NOT ISBLANK('Trip Details'[trip_distance])
			                && 'Trip Details'[trip_distance] > 0
			        ),
			        'Trip Details'[trip_distance], DESC,
			        'Trip Details'[Trip ID], ASC
			    )
			VAR MaxDistance =
			    MAXX(FarthestTrip, 'Trip Details'[trip_distance])
			VAR PickupLocationID =
			    MAXX(FarthestTrip, 'Trip Details'[PULocationID])
			VAR DropoffLocationID =
			    MAXX(FarthestTrip, 'Trip Details'[DOLocationID])
			VAR PickupLocation =
			    LOOKUPVALUE(
			        'Pickup Locations'[Location],
			        'Pickup Locations'[LocationID], PickupLocationID
			    )
			VAR DropoffLocation =
			    LOOKUPVALUE(
			        'Dropoff Locations'[Location],
			        'Dropoff Locations'[LocationID], DropoffLocationID
			    )
			RETURN
			    IF(
			        ISBLANK(MaxDistance),
			        BLANK(),
			        "Pickup: " & COALESCE(PickupLocation, "Unknown")
			            & " " & UNICHAR(8594) & " Drop-off: " & COALESCE(DropoffLocation, "Unknown")
			            & " (" & FORMAT(MaxDistance, "0.0") & " miles)"
			    )
		displayFolder: Measures
		lineageTag: 73ab1d1c-6163-4de4-85b3-35a4369c17f3

	/// Returns bookings only for the five highest-volume pickup locations in the current filter context.
	measure 'Top 5 Pickup Bookings' =
			VAR PickupLocationRank =
			    RANKX(
			        ALLSELECTED('Pickup Locations'[Location]),
			        [Total Bookings],
			        ,
			        DESC,
			        DENSE
			    )
			RETURN
			    IF(
			        PickupLocationRank <= 5,
			        [Total Bookings],
			        BLANK()
			    )
		isHidden
		displayFolder: Measures
		lineageTag: 5b2c5dce-6834-473e-8b7c-5d7a2600beb0

